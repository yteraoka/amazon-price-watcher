{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "addLabels": ["renovate"],
  "ignorePaths": ["evidence/**"],
  "packageRules": [
    {
      "groupName": "dev-dependencies",
      "matchDepTypes": [
        "devDependencies",
        "dev-dependencies",
        "dev"
      ],
      "addLabels": ["devDependencies"]
    },
    {
      "groupName": "evidence",
      "matchFileNames": ["evidence/package.json", "evidence/package-lock.json"],
      "addLabels": ["evidence"]
    },
    {
      "groupName": "root-python",
      "matchFileNames": ["requirements.txt"],
      "addLabels": ["python"]
    },
    {
      "groupName": "playwright-python",
      "matchFileNames": ["playwright/requirements.txt"],
      "addLabels": ["python"]
    },
    {
      "description": "pyee is a transitive dependency of playwright; playwright 1.63 requires pyee>=13,<14. Keep it in range so pip can resolve playwright/requirements.txt.",
      "matchFileNames": ["playwright/requirements.txt"],
      "matchPackageNames": ["pyee"],
      "allowedVersions": "<14"
    },
    {
      "groupName": "bs-python",
      "matchFileNames": ["bs/requirements.txt"],
      "addLabels": ["python"]
    }
  ]
}
